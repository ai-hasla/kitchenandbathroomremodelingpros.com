---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const breadcrumbs = [
  { label: 'Comparisons', href: '/comparisons/' },
];

const comparisons = [
  {
    title: 'Quartz vs Granite Countertops',
    description: 'Side-by-side comparison of cost, durability, maintenance, and resale value for Seattle kitchens. Find out which countertop material suits your lifestyle and budget.',
    href: '/comparisons/quartz-vs-granite-countertops-seattle/',
    category: 'Kitchen',
  },
  {
    title: 'Cabinet Refacing vs Replacement',
    description: 'Should you reface or fully replace your kitchen cabinets? We break down costs, timelines, and results so you can choose the right option for your Seattle home.',
    href: '/comparisons/cabinet-refacing-vs-replacement/',
    category: 'Kitchen',
  },
  {
    title: 'Walk-In Shower vs Bathtub',
    description: 'Choosing between a walk-in shower and a bathtub for your Seattle bathroom? Compare accessibility, cost, water usage, and resale impact.',
    href: '/comparisons/walk-in-shower-vs-bathtub/',
    category: 'Bathroom',
  },
  {
    title: 'Hardwood vs LVP Flooring',
    description: 'Hardwood and luxury vinyl plank both look stunning, but they perform very differently in Seattle homes. Compare moisture resistance, cost, and longevity.',
    href: '/comparisons/hardwood-vs-lvp-flooring-seattle/',
    category: 'Flooring',
  },
  {
    title: 'Custom vs Semi-Custom Cabinets',
    description: 'Is it worth going fully custom, or will semi-custom cabinets deliver the look you want at a lower price? Our expert breakdown for Seattle homeowners.',
    href: '/comparisons/custom-vs-semi-custom-cabinets/',
    category: 'Kitchen',
  },
];
---

<BaseLayout
  title="Kitchen & Bathroom Remodeling Comparisons — Seattle Expert Guides"
  description="Expert side-by-side comparisons of popular remodeling options for Seattle homes. Quartz vs granite, refacing vs replacement, walk-in shower vs bathtub, and more."
  canonical={`${SITE.url}/comparisons/`}
>
  <SchemaBreadcrumb items={breadcrumbs} />

  <!-- Hero -->
  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="bg-accent text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Expert Guides</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:var(--font-heading)] text-white mt-6 mb-6">Kitchen & Bathroom Remodeling Comparisons</h1>
        <p class="text-lg text-white/80 leading-relaxed">
          Making the right choice between two great options starts with understanding the differences. Our Seattle remodeling experts break down cost, durability, maintenance, and resale value so you can decide with confidence.
        </p>
      </div>
    </Container>
  </section>

  <!-- Comparison Grid -->
  <section class="py-16 lg:py-24 bg-white">
    <Container>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
        {comparisons.map((item) => (
          <a href={item.href} class="group block bg-light rounded-xl border border-border p-8 hover:border-accent hover:shadow-lg transition-all duration-300">
            <span class="bg-accent/10 text-accent text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">{item.category}</span>
            <h2 class="text-xl font-[family-name:var(--font-heading)] text-dark-text mt-4 mb-3 group-hover:text-accent transition-colors">{item.title}</h2>
            <p class="text-muted leading-relaxed text-sm mb-4">{item.description}</p>
            <span class="inline-flex items-center gap-1.5 text-accent font-semibold text-sm">
              Read comparison
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-primary">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-heading)] text-white mb-4">Still Not Sure Which Option Is Right?</h2>
        <p class="text-white/80 text-lg mb-8">Talk to our Seattle remodeling experts. We'll walk you through the pros and cons based on your home, budget, and goals — no pressure, no obligation.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={`tel:${SITE.phoneRaw}`} variant="primary" size="lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            {SITE.phone}
          </Button>
          <Button href="/get-a-quote/" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary">Get Free Estimate</Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Internal Links -->
  <section class="py-12 bg-white">
    <Container>
      <h2 class="text-2xl font-[family-name:var(--font-heading)] text-dark-text mb-6">Related Resources</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/services/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
          <span class="text-sm text-accent font-medium">Services</span>
          <p class="font-semibold text-dark-text mt-1">All Remodeling Services</p>
        </a>
        <a href="/cost-guides/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
          <span class="text-sm text-accent font-medium">Pricing</span>
          <p class="font-semibold text-dark-text mt-1">Cost Guides</p>
        </a>
        <a href="/blog/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
          <span class="text-sm text-accent font-medium">Blog</span>
          <p class="font-semibold text-dark-text mt-1">Remodeling Tips & Advice</p>
        </a>
        <a href="/gallery/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
          <span class="text-sm text-accent font-medium">Gallery</span>
          <p class="font-semibold text-dark-text mt-1">Project Photos</p>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
