        <span class="text-sm text-accent font-medium">Related Service</span>
        <p class="font-semibold text-dark-text mt-1">Flooring Installation</p>
      </a>
      <a href="/services/countertop-installation/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
