      </a>
      <a href="/services/shower-remodeling/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
        <span class="text-sm text-accent font-medium">Related Service</span>
        <p class="font-semibold text-dark-text mt-1">Shower Remodeling</p>
      </a>
      <a href="/areas-served/seattle/vanity-installation/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
        <span class="text-sm text-accent font-medium">Service Area</span>
