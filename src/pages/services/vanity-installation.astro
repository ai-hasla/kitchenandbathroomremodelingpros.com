        <span class="text-sm text-accent font-medium">Service Area</span>
        <p class="font-semibold text-dark-text mt-1">Vanity Installation in Bellevue</p>
      </a>
      <a href="/blog/floating-vs-freestanding-vanities/" class="block p-4 bg-light rounded-lg border border-border hover:border-accent transition-colors">
        <span class="text-sm text-accent font-medium">Blog</span>
