---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const title = 'Tub-to-Shower Conversion Cost in Seattle (2026) | Price Guide';
const description = 'How much does a tub-to-shower conversion cost in Seattle? Typical costs from $3,000 for basic conversions to $12,000+ for custom walk-in showers. Free estimates.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <SchemaBreadcrumb
    items={[
      { label: 'Cost Guides', href: '/cost-guides/' },
      { label: 'Tub-to-Shower Conversion Cost', href: '/cost-guides/tub-to-shower-conversion-cost/' },
    ]}
  />

  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <nav aria-label="Breadcrumb" class="text-sm text-white/60 mb-6">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li class="flex items-center gap-1.5">
              <span class="text-white/40">/</span>
              <a href="/cost-guides/" class="hover:text-white transition-colors">Cost Guides</a>
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-white/40">/</span>
              <span class="text-white font-medium">Tub-to-Shower Conversion Cost</span>
            </li>
          </ol>
        </nav>
        <h1 class="text-4xl lg:text-5xl font-[family-name:var(--font-heading)] text-white leading-tight mb-6">
          Tub-to-Shower Conversion Cost in Seattle
        </h1>
        <p class="text-white/80 text-lg leading-relaxed">
          Full pricing guide coming soon. Get a personalized quote for your tub-to-shower conversion today.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-16 lg:py-24">
    <Container>
      <div class="max-w-3xl mx-auto prose prose-lg">
        <p>We're currently finalizing this detailed cost guide for tub-to-shower conversions in the Seattle area. It will cover:</p>
        <ul>
          <li>Cost breakdowns by conversion type (basic, mid-range, custom walk-in)</li>
          <li>Material costs vs. labor costs in Seattle</li>
          <li>Factors that affect your final price</li>
          <li>How Seattle permitting costs factor in</li>
          <li>Financing options available</li>
        </ul>
        <p>In the meantime, tub-to-shower conversions in Seattle typically start from $3,000 for basic conversions. Every project is different, so contact us for a free in-home estimate with detailed line-item pricing.</p>
      </div>
      <div class="max-w-3xl mx-auto mt-10 flex flex-col sm:flex-row gap-4">
        <Button variant="primary" size="lg" href="/contact/">
          Get a Free Estimate
        </Button>
        <Button variant="outline" size="lg" href={`tel:${SITE.phoneRaw}`}>
          Call {SITE.phone}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
