<BaseLayout
  title="South Lake Union Condo Remodeling Guide | SLU"
  description="Kitchen and bathroom remodeling guide for South Lake Union condo owners. HOA approval, noise restrictions, building requirements, and costs for SLU high-rise renovations in 2026."
  canonical={`${SITE.url}/blog/south-lake-union-bathroom-kitchen-remodel/`}
  ogType="article"
  article={{ publishedTime: '2026-04-01', modifiedTime: '2026-04-05', author: SITE.name, section: 'Tips' }}
>
