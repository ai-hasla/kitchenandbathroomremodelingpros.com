---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const breadcrumbs = [
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Custom Cabinetry', href: '/reviews/custom-cabinetry/' },
];

const reviews = [
  {
    name: 'David & Susan C.',
    rating: 5,
    neighborhood: 'Mercer Island',
    date: 'February 2026',
    projectType: 'Custom Walnut Kitchen Cabinets',
    text: 'Full custom walnut cabinets built by a local shop. Every cabinet is the exact size needed. Soft-close dovetailed drawers. Hand-rubbed oil finish. Mixer lift in island, pull-out trash bins, spice rack. Took 8 weeks to build and 5 days to install. Worth every penny.',
  },
  {
    name: 'Patricia N.',
    rating: 5,
    neighborhood: 'Capitol Hill, Seattle',
    date: 'January 2026',
    projectType: 'Floor-to-Ceiling Custom Cabinets',
    text: 'Our Victorian has 10-foot ceilings and standard cabinets look ridiculous with a 2-foot gap. David designed floor-to-ceiling custom maple cabinets with glass-front uppers at the top. Crown molding meets ceiling seamlessly. These cabinets tripled our storage.',
  },
  {
    name: 'Mark & Linda H.',
    rating: 5,
    neighborhood: 'Magnolia, Seattle',
    date: 'December 2025',
    projectType: 'Butler Pantry Custom Cabinets',
    text: 'Complete butler pantry between kitchen and dining room. Custom painted navy blue cabinets, glass-front uppers, small countertop with sink, wine fridge cubby, integrated lighting. Inset doors instead of overlay for a refined look. Furniture-grade craftsmanship.',
  },
  {
    name: 'Rachel & Tom B.',
    rating: 4,
    neighborhood: 'Ballard, Seattle',
    date: 'November 2025',
    projectType: 'Custom Kitchen Cabinets',
    text: 'Custom white shaker cabinets throughout our Ballard kitchen. Plywood boxes, soft-close everything, dovetail drawers. Built-in sliding cutting board and tray divider. Four stars only because a two-week paint shop delay, but the finish quality was flawless when they arrived.',
  },
  {
    name: 'Steve & Carol P.',
    rating: 5,
    neighborhood: 'Everett',
    date: 'October 2025',
    projectType: 'Custom Island Cabinetry',
    text: 'Stock cabinets on the perimeter but needed a custom island for our odd-shaped kitchen. 4x8 foot island with waterfall quartz countertop, open shelving on one end, drawers on one side. Wood species and paint match existing cabinets perfectly. You would never know it was added later.',
  },
  {
    name: 'Karen & Ron J.',
    rating: 5,
    neighborhood: 'Sammamish',
    date: 'September 2025',
    projectType: 'Full Custom Kitchen',
    text: 'Replaced builder-grade cabinets with full custom cherry wood, inset doors, brass Armac Martin hardware from England. Peg board drawers, knife blocks, spice racks, pull-out compost bin. Install team took 3 days. Every door and drawer is perfectly aligned.',
  },
  {
    name: 'Emily R.',
    rating: 5,
    neighborhood: 'Wallingford, Seattle',
    date: 'August 2025',
    projectType: 'Custom Pantry + Mudroom',
    text: 'Custom pantry shelving and mudroom storage system. Pantry has adjustable shelves, pull-out bins, and microwave countertop. Mudroom has cubbies for each family member with hooks, shelves, and bench with storage underneath. All matching maple. The house feels so much more organized.',
  },
  {
    name: 'Jason & Mia T.',
    rating: 5,
    neighborhood: 'Redmond',
    date: 'July 2025',
    projectType: 'Modern Flat-Panel Custom',
    text: 'Clean modern look with flat-panel handleless doors, push-to-open mechanism, integrated pulls routed into door edges. White oak veneer over birch plywood. The precision for handleless cabinets is much higher because every gap must be perfectly even. Their cabinet maker delivered.',
  },
  {
    name: 'Diane P.',
    rating: 4,
    neighborhood: 'Shoreline',
    date: 'June 2025',
    projectType: 'Custom Cabinet Replacement',
    text: 'Replaced particle board cabinets with custom plywood-box cabinets with thermofoil doors. Added a narrow pull-out next to fridge, corner lazy susan that actually works, deeper lower cabinets. Four stars because thermofoil color was slightly different on one batch and had to be redone.',
  },
  {
    name: 'Michelle & Andrew L.',
    rating: 5,
    neighborhood: 'Issaquah',
    date: 'May 2025',
    projectType: 'Custom Two-Tone Cabinets',
    text: 'Two-tone custom cabinets — white uppers and dark gray lowers with brass hardware. Gray matches our floor tile, white matches quartz countertop. Full-extension blumotion soft-close drawers. The spice pull-out next to the range is my favorite detail. Neighbors have asked for the contact info three times.',
  },
];

const averageRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1);
const productId = `${SITE.url}/reviews/custom-cabinetry/#product`;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      name: 'Custom Cabinetry Service in Seattle, WA',
      description: `Professional custom cabinetry in Seattle. ${averageRating}-star rated across ${reviews.length} reviews.`,
      brand: { '@type': 'Brand', name: SITE.name },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: averageRating,
        reviewCount: String(reviews.length),
        bestRating: '5',
        worstRating: '1',
      },
    },
    ...reviews.map((r, i) => ({
      '@type': 'Review',
      '@id': `${productId}-review-${i}`,
      author: { '@type': 'Person', name: r.name },
      reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5' },
      reviewBody: r.text,
      itemReviewed: { '@id': productId },
    })),
  ],
};
---

<BaseLayout
  title="Custom Cabinetry Reviews Seattle | Best KB Remodeling"
  description={`Read ${reviews.length} custom cabinetry reviews from Seattle homeowners. ${averageRating}-star average. Walk-in showers, tub conversions, steam showers, and custom tile across Ballard, Capitol Hill, Queen Anne.`}
  canonical={`${SITE.url}/reviews/custom-cabinetry/`}
>
  <SchemaBreadcrumb items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />

  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <p class="text-accent font-semibold uppercase tracking-wider text-sm mb-3">Custom Cabinetry</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:var(--font-heading)] text-white mb-6">Custom Cabinetry Reviews</h1>
        <p class="text-lg text-white/80 leading-relaxed">Real reviews from Seattle homeowners who invested in custom-built cabinetry. From walnut kitchens to butler pantries.</p>
      </div>
    </Container>
  </section>

  <section class="py-8 bg-accent-light border-b border-border">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4" data-reveal>
        <div class="flex items-center gap-4">
          <p class="text-4xl font-bold font-[family-name:var(--font-heading)] text-primary">{averageRating}</p>
          <div>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-sm text-muted">{reviews.length} custom cabinetry reviews</p>
          </div>
        </div>
        <a href="/reviews/" class="text-sm font-medium text-accent hover:underline">&larr; All Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="grid md:grid-cols-2 gap-8" data-reveal-stagger>
        {reviews.map((review) => (
          <div class="bg-white border border-border rounded-2xl p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="font-semibold text-primary">{review.name}</h3>
                <p class="text-sm text-muted">{review.neighborhood} &middot; {review.date}</p>
              </div>
              <span class="text-xs font-medium bg-accent-light text-primary px-3 py-1 rounded-full">{review.projectType}</span>
            </div>
            <div class="flex gap-0.5 mb-4">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < review.rating ? 'text-accent' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-body-text leading-relaxed text-sm">{review.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 bg-light">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8" data-reveal>
        <h2 class="text-2xl md:text-3xl font-[family-name:var(--font-heading)] text-primary mb-4">Related Pages</h2>
      </div>
      <div class="flex flex-wrap gap-4 justify-center" data-reveal>
        <a href="/services/custom-cabinetry/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Custom Cabinetry Service</a>
        <a href="/cost-guides/custom-cabinetry-cost-seattle/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Custom Cabinetry Cost Guide</a>
        <a href="/reviews/cabinet-refacing/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Cabinet Refacing Reviews</a>
        <a href="/reviews/kitchen-remodeling/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Kitchen Remodeling Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20 bg-primary">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-heading)] text-white mb-4">Interested in Custom Cabinets?</h2>
        <p class="text-white/80 text-lg mb-8">Get a free consultation to discuss your custom cabinetry project. Call us or book online today.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="https://nexfield.pro/crm/book?u=137" target="_blank" rel="noopener noreferrer" variant="primary" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${SITE.phoneRaw}`} variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary">Call {SITE.phone}</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
