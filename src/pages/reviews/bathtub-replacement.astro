---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const breadcrumbs = [
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Bathtub Replacement', href: '/reviews/bathtub-replacement/' },
];

const reviews = [
  {
    name: 'Lisa D.',
    rating: 5,
    neighborhood: 'Kirkland',
    date: 'January 2026',
    projectType: 'Freestanding Tub Install',
    text: 'Replaced our old built-in jetted tub with a Woodbridge 67-inch freestanding soaking tub. They rerouted the drain and added a floor-mounted Delta filler faucet. The plumber hid all connections beautifully. Took 4 days total including demo and new tile around the area where the old tub sat.',
  },
  {
    name: 'Nadia & Paul G.',
    rating: 5,
    neighborhood: 'Wallingford, Seattle',
    date: 'December 2025',
    projectType: 'Alcove Tub Replacement',
    text: 'Our 1960s Wallingford home had the original cast iron tub weighing 300+ pounds. They pulled it out, reinforced the sagging subfloor, and installed a new Kohler Villager alcove tub with a tile surround matching our existing bathroom floor tile. Done in 5 days.',
  },
  {
    name: 'Janet M.',
    rating: 4,
    neighborhood: 'Ravenna, Seattle',
    date: 'November 2025',
    projectType: 'Soaking Tub Replacement',
    text: 'Replaced our old whirlpool tub with an Americh freestanding model. The drain location did not align so they opened the floor to reroute it, adding a day and about $400. They told us immediately with no surprises on the invoice.',
  },
  {
    name: 'Greg & Amy S.',
    rating: 5,
    neighborhood: 'Magnolia, Seattle',
    date: 'October 2025',
    projectType: 'Clawfoot Tub Installation',
    text: 'Found a vintage clawfoot at a Georgetown salvage yard. They refinished and installed it with custom exposed brushed nickel plumbing. Reinforced the floor joists because the tub weighs over 400 pounds filled. Looks like it has been in this house since 1910.',
  },
  {
    name: 'Deborah K.',
    rating: 5,
    neighborhood: 'Capitol Hill, Seattle',
    date: 'September 2025',
    projectType: 'Tub-to-Shower Conversion',
    text: 'We never used our bathtub. They removed the alcove tub and built a beautiful tiled walk-in shower in its place with rain showerhead, handheld wand, and corner bench. Kerdi waterproofing to the ceiling. Best decision for this bathroom.',
  },
  {
    name: 'Victor H.',
    rating: 5,
    neighborhood: 'Bellevue',
    date: 'August 2025',
    projectType: 'Japanese Soaking Tub',
    text: 'Installed a Signature Hardware Rosalind acrylic Japanese soaking tub. Deeper and shorter than standard. Adjusted drain height and added a dedicated circuit for the inline heater. Professional coordination from start to finish.',
  },
  {
    name: 'Hannah & Mark T.',
    rating: 5,
    neighborhood: 'Fremont, Seattle',
    date: 'July 2025',
    projectType: 'Bathtub + Surround Replacement',
    text: 'Our Fremont craftsman had a yellowing fiberglass insert. They demoed it, repaired water damage behind it, and installed a Kohler Archer with white subway tile surround and recessed niche. Simple, classic, and built to last.',
  },
  {
    name: 'Martha W.',
    rating: 4,
    neighborhood: 'Shoreline',
    date: 'June 2025',
    projectType: 'Bathtub Replacement',
    text: 'New Americast tub, Moen fixtures, and retiled surround with white ceramic. Nothing fancy but functional and well-done. Four stars because schedule slipped 3 days due to plumber availability, but the end result is solid.',
  },
  {
    name: 'Christine P.',
    rating: 5,
    neighborhood: 'Green Lake, Seattle',
    date: 'May 2025',
    projectType: 'Drop-In Tub Replacement',
    text: 'Large drop-in tub in a tile deck was leaking at the seams. They rebuilt the deck framing, waterproofed everything properly this time, and installed a new Jacuzzi Primo drop-in. Their attention to waterproofing detail was impressive.',
  },
  {
    name: 'Robert & Jean N.',
    rating: 5,
    neighborhood: 'Sammamish',
    date: 'April 2025',
    projectType: 'Freestanding Tub + Floor Tile',
    text: 'Victoria + Albert Amiata freestanding tub in matte white with heated porcelain floor tile and Riobel wall-mounted filler. The whole bathroom feels like a boutique hotel now. Worth every penny of the investment.',
  },
];

const averageRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1);
const productId = `${SITE.url}/reviews/bathtub-replacement/#product`;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      name: 'Bathtub Replacement Service in Seattle, WA',
      description: `Professional bathtub replacement in Seattle. ${averageRating}-star rated across ${reviews.length} reviews.`,
      brand: { '@type': 'Brand', name: SITE.name },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: averageRating,
        reviewCount: String(reviews.length),
        bestRating: '5',
        worstRating: '1',
      },
    },
    ...reviews.map((r, i) => ({
      '@type': 'Review',
      '@id': `${productId}-review-${i}`,
      author: { '@type': 'Person', name: r.name },
      reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5' },
      reviewBody: r.text,
      itemReviewed: { '@id': productId },
    })),
  ],
};
---

<BaseLayout
  title="Bathtub Replacement Reviews Seattle | Best KB Remodeling"
  description={`Read ${reviews.length} bathtub replacement reviews from Seattle homeowners. ${averageRating}-star average. Walk-in showers, tub conversions, steam showers, and custom tile across Ballard, Capitol Hill, Queen Anne.`}
  canonical={`${SITE.url}/reviews/bathtub-replacement/`}
>
  <SchemaBreadcrumb items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />

  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <p class="text-accent font-semibold uppercase tracking-wider text-sm mb-3">Bathtub Replacement</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:var(--font-heading)] text-white mb-6">Bathtub Replacement Reviews</h1>
        <p class="text-lg text-white/80 leading-relaxed">Real reviews from Seattle homeowners who replaced their bathtubs with our team.</p>
      </div>
    </Container>
  </section>

  <section class="py-8 bg-accent-light border-b border-border">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4" data-reveal>
        <div class="flex items-center gap-4">
          <p class="text-4xl font-bold font-[family-name:var(--font-heading)] text-primary">{averageRating}</p>
          <div>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-sm text-muted">{reviews.length} bathtub replacement reviews</p>
          </div>
        </div>
        <a href="/reviews/" class="text-sm font-medium text-accent hover:underline">&larr; All Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="grid md:grid-cols-2 gap-8" data-reveal-stagger>
        {reviews.map((review) => (
          <div class="bg-white border border-border rounded-2xl p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="font-semibold text-primary">{review.name}</h3>
                <p class="text-sm text-muted">{review.neighborhood} &middot; {review.date}</p>
              </div>
              <span class="text-xs font-medium bg-accent-light text-primary px-3 py-1 rounded-full">{review.projectType}</span>
            </div>
            <div class="flex gap-0.5 mb-4">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < review.rating ? 'text-accent' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-body-text leading-relaxed text-sm">{review.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 bg-light">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8" data-reveal>
        <h2 class="text-2xl md:text-3xl font-[family-name:var(--font-heading)] text-primary mb-4">Related Pages</h2>
      </div>
      <div class="flex flex-wrap gap-4 justify-center" data-reveal>
        <a href="/services/bathtub-replacement/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Bathtub Replacement Service</a>
        <a href="/cost-guides/bathtub-replacement-cost/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Bathtub Replacement Cost Guide</a>
        <a href="/reviews/bathroom-remodeling/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Bathroom Remodeling Reviews</a>
        <a href="/reviews/shower-remodeling/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Shower Remodeling Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20 bg-primary">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-heading)] text-white mb-4">Ready to Replace Your Bathtub?</h2>
        <p class="text-white/80 text-lg mb-8">Get a free, no-obligation estimate for your bathtub replacement. Call us or book online today.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="https://nexfield.pro/crm/book?u=137" target="_blank" rel="noopener noreferrer" variant="primary" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${SITE.phoneRaw}`} variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary">Call {SITE.phone}</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
