---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const breadcrumbs = [
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Vanity Installation', href: '/reviews/vanity-installation/' },
];

const reviews = [
  {
    name: 'Anita K.',
    rating: 5,
    neighborhood: 'Redmond',
    date: 'February 2026',
    projectType: 'Floating Vanity Install',
    text: 'Third project with this crew. 48-inch floating vanity with vessel sink and wood-look porcelain floor tile in our guest bath. Wall-mounted on steel brackets hitting the studs with added blocking. Looks incredible and makes the small bathroom feel bigger. Consistent quality every time.',
  },
  {
    name: 'Linda W.',
    rating: 5,
    neighborhood: 'Federal Way',
    date: 'January 2026',
    projectType: 'Double Vanity Replacement',
    text: 'Our Federal Way condo master bath had an old laminate vanity. They installed a 60-inch James Martin double vanity with Carrara quartz top and undermount sinks. Moen Align faucets in brushed gold. Plumber rerouted both drain lines to fit the new sink spacing. Project manager sent us photos daily.',
  },
  {
    name: 'Diane & Charles R.',
    rating: 5,
    neighborhood: 'Queen Anne, Seattle',
    date: 'December 2025',
    projectType: 'Custom Vanity Build',
    text: 'Custom floating vanity from reclaimed Douglas fir with concrete vessel sink. Wall-mounted Brizo faucet in matte black. It is the most photographed thing in our house. Guests always ask about it. True craftsman-level work from the team.',
  },
  {
    name: 'Wei & Jennifer L.',
    rating: 4,
    neighborhood: 'Bellevue',
    date: 'November 2025',
    projectType: 'Vanity + Mirror Replacement',
    text: 'Replaced the vanity and mirror in our hall bathroom. 36-inch Pottery Barn vanity in white with Carrara marble top and lighted medicine cabinet. Nice clean work. Four stars because mirror install was a separate visit a week later. Would have been nice to do both at once.',
  },
  {
    name: 'Sarah P.',
    rating: 5,
    neighborhood: 'Ballard, Seattle',
    date: 'October 2025',
    projectType: 'Double Vanity Upgrade',
    text: 'Upgraded from a single pedestal sink to a 72-inch double vanity in our Ballard master bath. Extended water supply lines and added a second drain. Quartz top because we have kids. Soft-close drawers, undermount sinks, Kohler Purist faucets. The bathroom finally works for two people. Took 6 days.',
  },
  {
    name: 'Karen & David F.',
    rating: 5,
    neighborhood: 'Magnolia, Seattle',
    date: 'September 2025',
    projectType: 'Antique Vanity Conversion',
    text: 'Found a beautiful antique dresser at an estate sale. The team cut the top to fit an undermount sink, waterproofed the interior, drilled for plumbing, and installed a Delta Trinsic faucet. They matched the hardware finish perfectly. Looks like it was always a vanity.',
  },
  {
    name: 'Michelle T.',
    rating: 5,
    neighborhood: 'Green Lake, Seattle',
    date: 'August 2025',
    projectType: 'Floating Vanity + Tile',
    text: 'Powder room refresh with 30-inch floating vanity from Virtu USA, vessel sink, wall-mounted faucet, and hexagon mosaic floor tile. The floating vanity makes the tiny room look much larger and is easier to clean under. Simple project, done in 4 days, looks like a magazine photo.',
  },
  {
    name: 'Alex & Jen H.',
    rating: 5,
    neighborhood: 'Wallingford, Seattle',
    date: 'July 2025',
    projectType: 'His & Hers Vanity Area',
    text: 'Two separate 36-inch vanities with makeup station in between. Each with its own lighted mirror and dedicated outlets. Continuous Caesarstone countertop across all three sections for a seamless look. Smart solution for a couple who gets ready at the same time.',
  },
  {
    name: 'Priya V.',
    rating: 4,
    neighborhood: 'Bothell',
    date: 'June 2025',
    projectType: 'Vanity Replacement',
    text: 'Straightforward vanity swap in our Bothell guest bath. Out with the old 30-inch, in with a nicer 36-inch from Home Decorators with granite top. Also replaced faucet and mirror. No plumbing surprises. Done in 2 days. Four stars because price felt high for a simple job, but quality was top notch.',
  },
  {
    name: 'Rachel & Tom B.',
    rating: 5,
    neighborhood: 'Capitol Hill, Seattle',
    date: 'May 2025',
    projectType: 'Dual Floating Vanities',
    text: 'Two wall-mounted vanities with heavy-duty french cleats and 2x6 blocking behind the drywall. Rock solid. LED strip lighting underneath gives an amazing floating glow at night. The plumber installed each drain cleanout accessibly but hidden. Very smart work.',
  },
];

const averageRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1);
const productId = `${SITE.url}/reviews/vanity-installation/#product`;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      name: 'Vanity Installation Service in Seattle, WA',
      description: `Professional vanity installation in Seattle. ${averageRating}-star rated across ${reviews.length} reviews.`,
      brand: { '@type': 'Brand', name: SITE.name },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: averageRating,
        reviewCount: String(reviews.length),
        bestRating: '5',
        worstRating: '1',
      },
    },
    ...reviews.map((r, i) => ({
      '@type': 'Review',
      '@id': `${productId}-review-${i}`,
      author: { '@type': 'Person', name: r.name },
      reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5' },
      reviewBody: r.text,
      itemReviewed: { '@id': productId },
    })),
  ],
};
---

<BaseLayout
  title="Vanity Installation Reviews Seattle | Best KB Remodeling"
  description={`Read ${reviews.length} vanity installation reviews from Seattle homeowners. ${averageRating}-star average. Walk-in showers, tub conversions, steam showers, and custom tile across Ballard, Capitol Hill, Queen Anne.`}
  canonical={`${SITE.url}/reviews/vanity-installation/`}
>
  <SchemaBreadcrumb items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />

  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <p class="text-accent font-semibold uppercase tracking-wider text-sm mb-3">Vanity Installation</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:var(--font-heading)] text-white mb-6">Vanity Installation Reviews</h1>
        <p class="text-lg text-white/80 leading-relaxed">Real reviews from Seattle homeowners who upgraded their bathroom vanities with our team.</p>
      </div>
    </Container>
  </section>

  <section class="py-8 bg-accent-light border-b border-border">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4" data-reveal>
        <div class="flex items-center gap-4">
          <p class="text-4xl font-bold font-[family-name:var(--font-heading)] text-primary">{averageRating}</p>
          <div>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-sm text-muted">{reviews.length} vanity installation reviews</p>
          </div>
        </div>
        <a href="/reviews/" class="text-sm font-medium text-accent hover:underline">&larr; All Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="grid md:grid-cols-2 gap-8" data-reveal-stagger>
        {reviews.map((review) => (
          <div class="bg-white border border-border rounded-2xl p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="font-semibold text-primary">{review.name}</h3>
                <p class="text-sm text-muted">{review.neighborhood} &middot; {review.date}</p>
              </div>
              <span class="text-xs font-medium bg-accent-light text-primary px-3 py-1 rounded-full">{review.projectType}</span>
            </div>
            <div class="flex gap-0.5 mb-4">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < review.rating ? 'text-accent' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-body-text leading-relaxed text-sm">{review.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 bg-light">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8" data-reveal>
        <h2 class="text-2xl md:text-3xl font-[family-name:var(--font-heading)] text-primary mb-4">Related Pages</h2>
      </div>
      <div class="flex flex-wrap gap-4 justify-center" data-reveal>
        <a href="/services/vanity-installation/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Vanity Installation Service</a>
        <a href="/cost-guides/vanity-installation-cost/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Vanity Installation Cost Guide</a>
        <a href="/reviews/bathroom-remodeling/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Bathroom Remodeling Reviews</a>
        <a href="/reviews/countertop-installation/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Countertop Installation Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20 bg-primary">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-heading)] text-white mb-4">Ready to Upgrade Your Vanity?</h2>
        <p class="text-white/80 text-lg mb-8">Get a free, no-obligation estimate for your vanity installation. Call us or book online today.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="https://nexfield.pro/crm/book?u=137" target="_blank" rel="noopener noreferrer" variant="primary" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${SITE.phoneRaw}`} variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary">Call {SITE.phone}</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
