---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import SchemaBreadcrumb from '@/components/seo/SchemaBreadcrumb.astro';
import { SITE } from '@/lib/constants';

const breadcrumbs = [
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Tile Installation', href: '/reviews/tile-installation/' },
];

const reviews = [
  {
    name: 'Amanda J.',
    rating: 5,
    neighborhood: 'Kent',
    date: 'January 2026',
    projectType: 'Floor Tile Installation',
    text: 'Wood-look porcelain plank tile throughout our Kent kitchen and bathrooms, about 450 square feet. Cuts around toilet flanges and door frames are flawless. The crew used a Raimondi leveling system so every tile sits perfectly flat. Done in 4 days including prep and grouting.',
  },
  {
    name: 'Chris P.',
    rating: 5,
    neighborhood: 'Fremont, Seattle',
    date: 'December 2025',
    projectType: 'Vintage Tile Restoration',
    text: 'Our Fremont craftsman bathroom had original 1920s hex tile in rough shape. Instead of ripping it out, they repaired loose tiles, re-grouted with period-appropriate dark gray, and sealed it. Also installed subway tile wainscoting. The bathroom feels like it belongs in the house again.',
  },
  {
    name: 'Doug & Patricia M.',
    rating: 5,
    neighborhood: 'Bellevue',
    date: 'November 2025',
    projectType: 'Kitchen Backsplash',
    text: 'Handmade Zellige tile backsplash in our Bellevue kitchen. Each tile is slightly different and the tile setter laid out the pattern dry before committing. No two tiles look the same and the overall effect is stunning. Real skill to get this right.',
  },
  {
    name: 'Kevin L.',
    rating: 4,
    neighborhood: 'Beacon Hill, Seattle',
    date: 'October 2025',
    projectType: 'Bathroom Floor & Wall Tile',
    text: 'Large-format 24x48 porcelain on walls and matching mosaic on shower floor. They floated the walls first for perfect flatness. Smart move for large-format tile. Four stars because one tile had a small chip and they had to order a replacement which took a week.',
  },
  {
    name: 'Stephanie & Brian W.',
    rating: 5,
    neighborhood: 'Wallingford, Seattle',
    date: 'September 2025',
    projectType: 'Herringbone Backsplash',
    text: 'The herringbone backsplash in our Wallingford kitchen is what everyone notices. Cloe 2.5x8 ceramic tile running counter to ceiling behind the range. Grout lines perfectly consistent. Our designer recommended them specifically because herringbone is hard to get right.',
  },
  {
    name: 'Monica S.',
    rating: 5,
    neighborhood: 'Shoreline',
    date: 'August 2025',
    projectType: 'Shower Tile Replacement',
    text: 'Our Shoreline ranch shower had mold behind the tile from bad waterproofing. They stripped to studs, found minor damage, installed Schluter Kerdi board, and retiled with marble-look porcelain. Added a niche and corner shelf. Waterproofing is bulletproof now. Done in 6 days.',
  },
  {
    name: 'Dan & Melissa K.',
    rating: 5,
    neighborhood: 'Capitol Hill, Seattle',
    date: 'July 2025',
    projectType: 'Bathroom Floor Tile',
    text: 'Replaced old vinyl with penny round porcelain mosaic in our Capitol Hill condo bathroom. Classic look. The threshold transition to hallway hardwood is seamless using a Schluter Reno-T edge trim in brushed nickel. Extra care around toilet base and vanity. Really meticulous.',
  },
  {
    name: 'Robert C.',
    rating: 5,
    neighborhood: 'Renton',
    date: 'June 2025',
    projectType: 'Entryway + Kitchen Tile',
    text: 'Tiled our Renton split-level entryway and kitchen with Daltile Emerson porcelain in staggered plank pattern, about 380 sqft. Looks like real hardwood from a distance. They leveled the subfloor in several spots first due to decades of settling. Very thorough prep work.',
  },
  {
    name: 'Tina & James R.',
    rating: 4,
    neighborhood: 'Sammamish',
    date: 'May 2025',
    projectType: 'Master Bath Full Tile',
    text: 'Floor-to-ceiling Marazzi marble-look porcelain in our Sammamish master bath, about 285 sqft total. Decorative accent strip at eye height. Four stars because grouting in one shower corner was slightly uneven. They came back promptly and fixed it without any pushback.',
  },
  {
    name: 'Emily & Josh H.',
    rating: 5,
    neighborhood: 'Issaquah',
    date: 'April 2025',
    projectType: 'Fireplace Surround + Hearth',
    text: 'Stacked natural stone veneer on our fireplace surround and hearth. Cuts around the mantel and firebox are precise. Grout is nearly invisible giving a clean modern look. They also did our kitchen backsplash last year. Same excellent quality on our second project.',
  },
];

const averageRating = (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1);
const productId = `${SITE.url}/reviews/tile-installation/#product`;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      name: 'Tile Installation Service in Seattle, WA',
      description: `Professional tile installation in Seattle. ${averageRating}-star rated across ${reviews.length} reviews.`,
      brand: { '@type': 'Brand', name: SITE.name },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: averageRating,
        reviewCount: String(reviews.length),
        bestRating: '5',
        worstRating: '1',
      },
    },
    ...reviews.map((r, i) => ({
      '@type': 'Review',
      '@id': `${productId}-review-${i}`,
      author: { '@type': 'Person', name: r.name },
      reviewRating: { '@type': 'Rating', ratingValue: String(r.rating), bestRating: '5' },
      reviewBody: r.text,
      itemReviewed: { '@id': productId },
    })),
  ],
};
---

<BaseLayout
  title="Tile Installation Reviews Seattle | Best KB Remodeling"
  description={`Read ${reviews.length} tile installation reviews from Seattle homeowners. ${averageRating}-star average. Walk-in showers, tub conversions, steam showers, and custom tile across Ballard, Capitol Hill, Queen Anne.`}
  canonical={`${SITE.url}/reviews/tile-installation/`}
>
  <SchemaBreadcrumb items={breadcrumbs} />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />

  <section class="bg-primary pt-32 pb-16">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <p class="text-accent font-semibold uppercase tracking-wider text-sm mb-3">Tile Installation</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[family-name:var(--font-heading)] text-white mb-6">Tile Installation Reviews</h1>
        <p class="text-lg text-white/80 leading-relaxed">Real reviews from Seattle homeowners who trusted us with their tile work. From backsplashes to full bathroom floors, see what our clients say.</p>
      </div>
    </Container>
  </section>

  <section class="py-8 bg-accent-light border-b border-border">
    <Container>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4" data-reveal>
        <div class="flex items-center gap-4">
          <p class="text-4xl font-bold font-[family-name:var(--font-heading)] text-primary">{averageRating}</p>
          <div>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-sm text-muted">{reviews.length} tile installation reviews</p>
          </div>
        </div>
        <a href="/reviews/" class="text-sm font-medium text-accent hover:underline">&larr; All Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="grid md:grid-cols-2 gap-8" data-reveal-stagger>
        {reviews.map((review) => (
          <div class="bg-white border border-border rounded-2xl p-8 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="font-semibold text-primary">{review.name}</h3>
                <p class="text-sm text-muted">{review.neighborhood} &middot; {review.date}</p>
              </div>
              <span class="text-xs font-medium bg-accent-light text-primary px-3 py-1 rounded-full">{review.projectType}</span>
            </div>
            <div class="flex gap-0.5 mb-4">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < review.rating ? 'text-accent' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-body-text leading-relaxed text-sm">{review.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 bg-light">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8" data-reveal>
        <h2 class="text-2xl md:text-3xl font-[family-name:var(--font-heading)] text-primary mb-4">Related Pages</h2>
      </div>
      <div class="flex flex-wrap gap-4 justify-center" data-reveal>
        <a href="/services/tile-installation/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Tile Installation Service</a>
        <a href="/cost-guides/tile-installation-cost-seattle/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Tile Installation Cost Guide</a>
        <a href="/reviews/shower-remodeling/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Shower Remodeling Reviews</a>
        <a href="/reviews/flooring-installation/" class="inline-flex items-center gap-2 border border-border bg-white rounded-lg px-5 py-3 hover:shadow-md transition-shadow text-sm font-medium text-primary">Flooring Installation Reviews</a>
      </div>
    </Container>
  </section>

  <section class="py-20 bg-primary">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-heading)] text-white mb-4">Need Expert Tile Work?</h2>
        <p class="text-white/80 text-lg mb-8">Get a free, no-obligation estimate for your tile installation project. Call us or book online today.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="https://nexfield.pro/crm/book?u=137" target="_blank" rel="noopener noreferrer" variant="primary" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${SITE.phoneRaw}`} variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary">Call {SITE.phone}</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
