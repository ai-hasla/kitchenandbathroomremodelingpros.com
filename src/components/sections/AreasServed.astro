---
import Container from '@/components/ui/Container.astro';
import { LOCATIONS_TIER1, LOCATIONS_TIER2 } from '@/lib/constants';
---

<section class="py-16 lg:py-24 bg-primary">
  <Container>
    <!-- Section Header -->
    <div class="text-center mb-12" data-reveal>
      <h2 class="text-3xl lg:text-4xl font-[family-name:var(--font-heading)] text-white leading-tight mb-4">
        Proudly Serving the Greater Seattle Area
      </h2>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        From Seattle to Tacoma and everywhere in between, our team delivers expert kitchen and
        bathroom remodeling across the Puget Sound region.
      </p>
    </div>

    <!-- Location Grid with Service Links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-8" data-reveal>
      {LOCATIONS_TIER1.map((location) => (
        <div class="bg-white/5 hover:bg-white/10 rounded-lg px-4 py-3 transition-colors">
          <a
            href={`/areas-served/${location.slug}/`}
            class="text-white font-medium block mb-1.5 hover:text-accent transition-colors"
          >
            {location.city}, WA
          </a>
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            <a
              href={`/areas-served/${location.slug}/kitchen-remodeling/`}
              class="text-white/50 text-xs hover:text-accent transition-colors"
            >
              Kitchen
            </a>
            <a
              href={`/areas-served/${location.slug}/bathroom-remodeling/`}
              class="text-white/50 text-xs hover:text-accent transition-colors"
            >
              Bathroom
            </a>
            <a
              href={`/areas-served/${location.slug}/cabinet-refacing/`}
              class="text-white/50 text-xs hover:text-accent transition-colors"
            >
              Cabinets
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Tier 2 Cities (compact) -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" data-reveal>
      {LOCATIONS_TIER2.slice(0, 10).map((location) => (
        <a
          href={`/areas-served/${location.slug}/`}
          class="text-white/50 hover:text-accent text-sm transition-colors"
        >
          {location.city}
        </a>
      ))}
    </div>

    <!-- See All Link -->
    <div class="text-center" data-reveal>
      <a
        href="/areas-served/"
        class="inline-flex items-center gap-2 text-accent font-semibold hover:gap-3 transition-all duration-300"
      >
        See All {LOCATIONS_TIER1.length + LOCATIONS_TIER2.length} Service Areas
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Container>
</section>
