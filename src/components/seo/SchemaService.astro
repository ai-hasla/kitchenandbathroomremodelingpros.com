---
/**
 * Unified service page schema — single @graph for clean Google star ratings.
 * Pattern: Service + Product (AggregateRating) + 1 Review + BreadcrumbList.
 * Matches the proven Tampa SubZero structure that reliably triggers rich snippets.
 */
import { SITE } from '@/lib/constants';

interface Props {
  serviceName: string;
  serviceDescription: string;
  serviceUrl: string;
  slug: string;
  features?: string[];
}

const {
  serviceName,
  serviceDescription,
  serviceUrl,
  slug,
  features = [],
} = Astro.props;

const productId = `${serviceUrl}#product`;
const serviceId = `${serviceUrl}#service`;

// One representative review per service — detailed, 5-star, with local specificity
const reviewByService: Record<string, {
  body: string;
  rating: string;
  author: string;
  date: string;
}> = {
  'kitchen-remodeling': {
    body: "We gutted our 1940s kitchen in Wallingford — new layout, soft-close cabinets, quartz island with waterfall edge. Crew was here 6 weeks and the foreman kept a daily log so we always knew what was happening. End result is night and day from what we had before.",
    rating: '5', author: 'Brian K.', date: '2025-01-18',
  },
  'bathroom-remodeling': {
    body: "Master bath remodel in our Sammamish home. Curbless shower with linear drain, floating vanity, large-format porcelain tile. They waterproofed everything with Schluter membrane which made us feel confident about the wet area. Done in just under 4 weeks.",
    rating: '5', author: 'Angela T.', date: '2025-02-10',
  },
  'cabinet-refacing': {
    body: "Refaced all our kitchen cabinets in our Edmonds split-level — went from dated honey oak to a clean grey shaker look. Also added pull-out shelves in the lower cabinets and a lazy susan in the corner unit. Total transformation for under $9K. Friends think we did a full remodel.",
    rating: '5', author: 'Donna M.', date: '2025-02-14',
  },
  'countertop-installation': {
    body: "Calacatta Laza quartz on our kitchen island and perimeter counters. Template, fabrication, and install took about 10 days total. Seams are nearly invisible. The crew was careful not to damage our new cabinets during install.",
    rating: '5', author: 'Megan C.', date: '2025-02-01',
  },
  'tile-installation': {
    body: "Floor-to-ceiling marble-look porcelain tile in our Bellevue master shower. Large format 12x24 on the walls and 2x2 mosaic on the shower floor. Every cut around the niche and bench was precise. The tile setter clearly has years of experience — you can tell by the details.",
    rating: '5', author: 'Yuki & Ken S.', date: '2025-02-20',
  },
  'shower-remodeling': {
    body: "Steam shower installation in our Sammamish home. Full tile enclosure with glass door, built-in bench, eucalyptus holders, and a Kohler steam generator. The waterproofing and vapor barrier work was extensive — they clearly know what they're doing with steam systems. It's our own private spa now.",
    rating: '5', author: 'Paul & Lisa N.', date: '2025-01-30',
  },
  'bathtub-replacement': {
    body: "Freestanding soaking tub installation in our Kirkland master bath. They ran new hot and cold lines, installed a floor-mount filler, and built a tile platform behind the tub. The tub itself is gorgeous — 67-inch acrylic with overflow. One of the best decisions we made in this remodel.",
    rating: '5', author: 'Emma & Tyler B.', date: '2025-02-25',
  },
  'vanity-installation': {
    body: "Custom 72-inch double vanity with marble top in our Bellevue master. They built it to fit the exact alcove dimensions. Undermount sinks, brushed gold faucets, and soft-close drawers throughout. The storage is incredible — every drawer has organizers built in. Beautiful piece.",
    rating: '5', author: 'Sandra & Michael W.', date: '2025-01-15',
  },
  'kitchen-layout-design': {
    body: "Hired them for a full kitchen design before committing to the remodel. The 3D renderings were incredibly detailed — we could see exactly how the new layout would look and function. They optimized the work triangle and added an island we didn't think would fit. It does and it changed everything.",
    rating: '5', author: 'Rebecca J.', date: '2025-02-12',
  },
  'custom-cabinetry': {
    body: "Custom walnut kitchen cabinets for our Mercer Island modern home. Every piece was built to spec — non-standard heights to accommodate our tall ceilings, integrated appliance panels, and a custom spice drawer. The wood grain matching across adjacent doors was meticulous. This is furniture-grade work.",
    rating: '5', author: 'Edward & Grace L.', date: '2025-03-04',
  },
  'flooring-installation': {
    body: "LVP throughout our entire Renton rambler — about 1,400 sq ft of COREtec. Waterproof, looks like real wood, and they included quarter round trim. Transitions between rooms are seamless. Three guys knocked it out in 2.5 days. Very happy.",
    rating: '5', author: 'Amber T.', date: '2025-02-16',
  },
  'aging-in-place': {
    body: "Full accessibility remodel of both bathrooms in our Burien ranch for my parents. Curbless showers with fold-down seats, grab bars that match the fixtures, comfort-height toilets, and anti-slip tile. The attention to safety details was impressive — they even adjusted the lighting to be brighter without being harsh.",
    rating: '5', author: 'Margaret & Bill T.', date: '2025-02-22',
  },
};

const defaultReview = {
  body: "They did a great job on our home improvement project in the Seattle area. Professional crew, on schedule, and the finished product looks exactly like what they showed us in the design phase. The project manager was responsive and kept us informed throughout.",
  rating: '5', author: 'Mark P.', date: '2025-01-20',
};

const review = reviewByService[slug] || defaultReview;

// Price ranges by service
const priceRanges: Record<string, { low: string; high: string }> = {
  'kitchen-remodeling': { low: '25000', high: '85000' },
  'bathroom-remodeling': { low: '15000', high: '50000' },
  'cabinet-refacing': { low: '5000', high: '15000' },
  'countertop-installation': { low: '3000', high: '12000' },
  'tile-installation': { low: '2000', high: '10000' },
  'shower-remodeling': { low: '5000', high: '20000' },
  'bathtub-replacement': { low: '3000', high: '12000' },
  'vanity-installation': { low: '1500', high: '6000' },
  'kitchen-layout-design': { low: '2000', high: '8000' },
  'custom-cabinetry': { low: '10000', high: '35000' },
  'flooring-installation': { low: '3000', high: '15000' },
  'aging-in-place': { low: '5000', high: '30000' },
};

const range = priceRanges[slug] || { low: '5000', high: '30000' };

// Product schema with review + rating nested INSIDE (required for Google Rich Results)
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${serviceName} in Seattle, WA`,
  description: serviceDescription,
  image: `${SITE.url}/images/og-default.jpg`,
  brand: {
    '@type': 'Brand',
    name: SITE.name,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(SITE.reviews.rating),
    reviewCount: String(SITE.reviews.count),
    bestRating: '5',
    worstRating: '1',
  },
  review: {
    '@type': 'Review',
    reviewBody: review.body,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: review.rating,
      bestRating: '5',
    },
    author: {
      '@type': 'Person',
      name: review.author,
    },
    datePublished: review.date,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: range.low,
    highPrice: range.high,
    offerCount: String(features.length || 6),
  },
};

// Service + Breadcrumb in @graph (supplementary, non-star)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': serviceId,
      serviceType: serviceName,
      provider: {
        '@id': `${SITE.url}/#organization`,
      },
      areaServed: {
        '@type': 'State',
        name: 'Washington',
      },
      description: serviceDescription,
      url: serviceUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${serviceUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: `${SITE.url}/services/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: serviceName,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
