---
/**
 * Product schema with AggregateRating + Reviews
 * This is the key schema type that triggers Google star ratings in search results.
 * Uses @graph structure for maximum rich snippet potential.
 *
 * IMPORTANT: When `reviews` prop is passed, only those reviews appear in schema.
 * Schema reviews MUST be an exact subset of visible reviews on the page.
 * Never include phantom (non-visible) reviews.
 */
import { SITE } from '@/lib/constants';
import type { PageReview } from '@/lib/review-selector';

interface Props {
  productName?: string;
  productDescription?: string;
  pageUrl?: string;
  lowPrice?: string;
  /** Per-page reviews to embed in schema. If omitted, no reviews are included. */
  reviews?: PageReview[];
  /** Override aggregate review count. Defaults to reviews.length if reviews provided. */
  reviewCount?: number;
  /** Override aggregate rating value. Defaults to SITE.reviews.rating. */
  ratingValue?: number;
}

const {
  productName = 'Kitchen & Bathroom Remodeling Service',
  productDescription = `Expert kitchen and bathroom remodeling in Seattle. ${SITE.reviews.rating}-star rated with ${SITE.reviews.count}+ verified reviews. ${SITE.warranty} warranty, free estimates. Serving Seattle, Bellevue, Kirkland, and 20+ Puget Sound communities since ${SITE.yearFounded}.`,
  pageUrl = SITE.url,
  lowPrice = '5000',
  reviews,
  reviewCount,
  ratingValue,
} = Astro.props;

const productId = `${pageUrl}#product`;

// Build rating values
const effectiveRating = ratingValue ?? SITE.reviews.rating;
const effectiveCount = reviewCount ?? (reviews ? reviews.length : SITE.reviews.count);

// Build schema reviews from passed reviews (visible on page) — never phantom
const schemaReviews = (reviews ?? []).map((r, i) => ({
  '@type': 'Review' as const,
  '@id': `${productId}-review-${i}`,
  reviewBody: r.text,
  reviewRating: {
    '@type': 'Rating' as const,
    ratingValue: String(r.rating),
    bestRating: '5',
  },
  author: { '@type': 'Person' as const, name: r.author },
  datePublished: r.date,
  itemReviewed: { '@id': productId },
}));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': productId,
      name: productName,
      image: `${SITE.url}/images/og-default.jpg`,
      description: productDescription,
      brand: {
        '@type': 'Brand',
        name: SITE.name,
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: String(effectiveRating),
        reviewCount: String(effectiveCount),
        bestRating: '5',
        worstRating: '1',
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: lowPrice,
        availability: 'https://schema.org/InStock',
      },
    },
    ...schemaReviews,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
